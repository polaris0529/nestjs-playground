# 서버 포트 (기본 3000)
SERVER_PORT=3000

# 로그 레벨: debug | log | warn | error (개발: log, 프로덕션: warn)
LOG_LEVEL=log

# Docker Compose DB 설정
POSTGRES_USER=allinone
POSTGRES_PASSWORD=changeme
POSTGRES_DB=allinone

# DB 연결: Docker 내부 DNS(db) 기준 PostgreSQL 연결 문자열 (TypeORM 사용)
DATABASE_URL="postgresql://allinone:changeme@db:5432/allinone"

# JWT / Cookie 설정
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=1800
JWT_REFRESH_EXPIRES_IN=604800
COOKIE_ACCESS_NAME=access_token
COOKIE_REFRESH_NAME=refresh_token
