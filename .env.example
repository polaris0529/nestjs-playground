# 서버 포트 (기본 3000)
SERVER_PORT=3000

# 로그 레벨: debug | log | warn | error (개발: log, 프로덕션: warn)
LOG_LEVEL=log

# DB 연결: PostgreSQL 연결 문자열 (TypeORM 사용)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Docker Compose DB 설정
POSTGRES_USER=allinone
POSTGRES_PASSWORD=changeme
POSTGRES_DB=allinone