<!DOCTYPE html>
<html lang="ko">
{{> head title=title}}
<body>
  {{> header}}
  {{> sidebar page=page}}

  <div class="app-main">
    <div class="app-content">
      <div class="page-header">
        <div>
          <h1>{{title}}</h1>
          <p>날짜 기준 공통 태스크와 개인 태스크를 관리합니다.</p>
        </div>
        <button type="button" class="btn btn-primary" id="newTaskButton">태스크 등록</button>
      </div>

      <div
        id="calendarPage"
        class="calendar-workspace"
        data-is-admin="{{isAdmin}}"
        data-admin-mode="{{adminMode}}"
      >
        <section class="calendar-surface" aria-label="캘린더">
          <div id="calendarMessage" class="calendar-message" role="alert"></div>
          <div id="workflowCalendar"></div>
        </section>

        <aside class="calendar-detail-panel" aria-label="선택 날짜 상세">
          <div class="calendar-panel-head">
            <span class="calendar-kicker">SELECTED DATE</span>
            <strong id="selectedDateLabel">날짜를 선택하세요</strong>
          </div>
          <dl class="calendar-day-meta">
            <div>
              <dt>요일</dt>
              <dd id="selectedDayOfWeek">-</dd>
            </div>
            <div>
              <dt>근무일</dt>
              <dd id="selectedWorkday">-</dd>
            </div>
            <div>
              <dt>공휴일</dt>
              <dd id="selectedHoliday">-</dd>
            </div>
          </dl>

          {{#if isAdmin}}
          <form id="calendarDayForm" class="calendar-day-form d-none" novalidate>
            <input type="hidden" id="dayCalendarDate" />
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" id="dayIsHoliday" />
              <label class="form-check-label" for="dayIsHoliday">공휴일</label>
            </div>
            <div class="mb-3">
              <label for="dayHolidayName" class="form-label">공휴일명</label>
              <input type="text" class="form-control" id="dayHolidayName" maxlength="100" />
            </div>
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" id="dayIsWorkday" />
              <label class="form-check-label" for="dayIsWorkday">근무일</label>
            </div>
            <button type="submit" class="btn btn-outline-primary w-100">날짜 정보 저장</button>
          </form>
          {{/if}}
        </aside>
      </div>
    </div>
    {{> footer version="0.0.1"}}
  </div>

  <div id="taskModal" class="modal-overlay d-none" aria-hidden="true">
    <div class="modal-box calendar-modal">
      <div class="modal-head">
        <h2 class="modal-title" id="taskModalTitle">태스크 등록</h2>
        <button type="button" class="modal-close" data-modal-close>&times;</button>
      </div>
      <div class="modal-body">
        <form id="taskForm" novalidate>
          <input type="hidden" id="taskId" />
          <div class="mb-3">
            <label for="taskType" class="form-label">태스크 구분</label>
            <select class="form-select" id="taskType" required>
              <option value="PERSONAL">개인 태스크</option>
              {{#if isAdmin}}
              <option value="COMMON">공통 태스크</option>
              {{/if}}
            </select>
          </div>
          <div class="mb-3">
            <label for="taskCalendarDate" class="form-label">날짜</label>
            <input type="date" class="form-control" id="taskCalendarDate" required />
          </div>
          <div class="mb-3">
            <label for="taskTitle" class="form-label">제목</label>
            <input type="text" class="form-control" id="taskTitle" maxlength="100" required />
          </div>
          <div class="mb-3">
            <label for="taskContent" class="form-label">상세 내용</label>
            <textarea class="form-control" id="taskContent" rows="4" maxlength="2000"></textarea>
          </div>
          <div class="calendar-form-grid">
            <div class="mb-3">
              <label for="taskStatus" class="form-label">상태</label>
              <select class="form-select" id="taskStatus" required>
                <option value="TODO">TODO</option>
                <option value="IN_PROGRESS">IN_PROGRESS</option>
                <option value="DONE">DONE</option>
                <option value="CANCELLED">CANCELLED</option>
              </select>
            </div>
            <div class="mb-3" data-personal-field>
              <label for="taskPriority" class="form-label">우선순위</label>
              <select class="form-select" id="taskPriority">
                <option value="NORMAL">NORMAL</option>
                <option value="LOW">LOW</option>
                <option value="HIGH">HIGH</option>
              </select>
            </div>
            <div class="mb-3 d-none" data-common-field>
              <label for="taskCategory" class="form-label">분류</label>
              <input type="text" class="form-control" id="taskCategory" maxlength="50" />
            </div>
            <div class="mb-3">
              <label for="taskStartTime" class="form-label">시작 시간</label>
              <input type="time" class="form-control" id="taskStartTime" />
            </div>
            <div class="mb-3">
              <label for="taskEndTime" class="form-label">종료 시간</label>
              <input type="time" class="form-control" id="taskEndTime" />
            </div>
          </div>
          <div id="taskMessage" role="alert"></div>
          <div class="d-flex justify-content-between gap-2">
            <button type="button" class="btn btn-outline-danger d-none" id="deleteTaskButton">삭제</button>
            <div class="ms-auto d-flex gap-2">
              <button type="button" class="btn btn-outline-secondary" data-modal-close>취소</button>
              <button type="submit" class="btn btn-primary">저장</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  {{> scripts}}
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@{{fullCalendarVersion}}/index.global.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core@{{fullCalendarVersion}}/locales/ko.global.min.js"></script>
  <script src="/js/calendar/calendar.js"></script>
</body>
</html>
