<!DOCTYPE html>
<html lang="ko">
{{> head title="공통코드 그룹 생성"}}
<body>
  {{> header}}
  {{> sidebar page="admin-common-code-group"}}

  <div class="app-main">
    <div class="app-content">
      <div class="page-header">
        <div>
          <h1>공통코드 그룹 생성</h1>
          <p>MENU_TYPE, USE_YN 등 코드 그룹을 등록합니다.</p>
        </div>
      </div>

      <div class="row">
        <div class="col-lg-7">
          <div class="card shadow-md rounded-lg">
            <div class="card-body">
              <form id="codeGroupForm" novalidate>
                <div class="mb-3">
                  <label for="groupCode" class="form-label">그룹코드</label>
                  <input type="text" class="form-control" id="groupCode" name="groupCode"
                    placeholder="예: MENU_TYPE" required />
                  <div class="form-text">대문자로 시작하는 영대문자/숫자/_ 조합</div>
                </div>

                <div class="mb-3">
                  <label for="groupName" class="form-label">그룹명</label>
                  <input type="text" class="form-control" id="groupName" name="groupName"
                    placeholder="예: 메뉴유형" required />
                </div>

                <div class="mb-3">
                  <label for="description" class="form-label">설명 <span class="text-muted">(선택)</span></label>
                  <input type="text" class="form-control" id="description" name="description" />
                </div>

                <div class="mb-3">
                  <label for="useYn" class="form-label">사용여부</label>
                  <select class="form-select" id="useYn" name="useYn" data-code-group="USE_YN" required></select>
                </div>

                <div id="formMessage" class="mb-3" role="alert"></div>

                <button type="submit" class="btn btn-primary">생성</button>
                <a href="/admin" class="btn btn-outline-secondary">취소</a>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
    {{> footer version="0.0.1"}}
  </div>

  {{> scripts}}
  <script src="/js/admin/form-util.js"></script>
  <script src="/js/admin/common-code-group/new.js"></script>
</body>
</html>
