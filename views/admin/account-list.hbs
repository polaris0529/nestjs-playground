<!DOCTYPE html>
<html lang="ko">
{{> head title="계정 관리"}}
<body>
  {{> header}}
  {{> sidebar page="admin-account"}}

  <div class="app-main">
    <div class="app-content">
      <div class="page-header">
        <div>
          <h1>계정 관리</h1>
          <p>계정 목록 조회 · 수정 · 비활성화</p>
        </div>
        <a href="/admin/account/new" class="btn btn-primary">신규 계정</a>
      </div>

      <div id="formMessage" role="alert"></div>

      <div class="card shadow-md rounded-lg">
        <div class="card-body">
          <table id="accountTable" class="admin-table"></table>
        </div>
      </div>
    </div>
    {{> footer version="0.0.1"}}
  </div>

  <!-- 수정 모달 -->
  <div id="accountEditModal" class="modal-overlay d-none">
    <div class="modal-box">
      <div class="modal-head">
        <h2 class="modal-title">계정 수정</h2>
        <button type="button" class="modal-close" data-modal-close>&times;</button>
      </div>
      <div class="modal-body">
        <form id="accountEditForm" novalidate>
          <input type="hidden" id="editId" />
          <div class="mb-3">
            <label class="form-label">로그인 ID</label>
            <input type="text" class="form-control" id="editLoginId" disabled />
          </div>
          <div class="mb-3">
            <label for="editAccountName" class="form-label">이름</label>
            <input type="text" class="form-control" id="editAccountName" required />
          </div>
          <div class="mb-3">
            <label for="editUseYn" class="form-label">사용여부</label>
            <select class="form-select" id="editUseYn" data-code-group="USE_YN" required></select>
          </div>
          <div id="modalMessage" role="alert"></div>
          <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary" data-modal-close>취소</button>
            <button type="submit" class="btn btn-primary">저장</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  {{> scripts}}
  <script src="/js/admin/form-util.js"></script>
  <script src="/js/admin/crud-util.js"></script>
  <script src="/js/admin/account/list.js"></script>
</body>
</html>
