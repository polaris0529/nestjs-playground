<!DOCTYPE html>
<html lang="ko">
{{> head title="메뉴 생성"}}
<body>
  {{> header}}
  {{> sidebar page="admin-menu"}}

  <div class="app-main">
    <div class="app-content">
      <div class="page-header">
        <div>
          <h1>메뉴 생성</h1>
          <p>메뉴유형·열기방식은 공통코드에서 선택합니다.</p>
        </div>
      </div>

      <div class="row">
        <div class="col-lg-7">
          <div class="card shadow-md rounded-lg">
            <div class="card-body">
              <form id="menuForm" novalidate>
                <div class="mb-3">
                  <label for="parentMenuId" class="form-label">상위 메뉴</label>
                  <select class="form-select" id="parentMenuId" name="parentMenuId"></select>
                </div>

                <div class="mb-3">
                  <label for="menuCode" class="form-label">메뉴코드</label>
                  <input type="text" class="form-control" id="menuCode" name="menuCode"
                    placeholder="예: USER_LIST" required />
                  <div class="form-text">대문자로 시작하는 영대문자/숫자/_ 조합</div>
                </div>

                <div class="mb-3">
                  <label for="menuName" class="form-label">메뉴명</label>
                  <input type="text" class="form-control" id="menuName" name="menuName"
                    placeholder="예: 사용자 목록" required />
                </div>

                <div class="mb-3">
                  <label for="menuUrl" class="form-label">메뉴 URL <span class="text-muted">(선택)</span></label>
                  <input type="text" class="form-control" id="menuUrl" name="menuUrl"
                    placeholder="예: /admin/users" />
                </div>

                <div class="mb-3">
                  <label for="menuType" class="form-label">메뉴유형</label>
                  <select class="form-select" id="menuType" name="menuType" data-code-group="MENU_TYPE" required></select>
                </div>

                <div class="mb-3">
                  <label for="openType" class="form-label">열기방식 <span class="text-muted">(선택)</span></label>
                  <select class="form-select" id="openType" name="openType" data-code-group="OPEN_TYPE"></select>
                </div>

                <div class="mb-3">
                  <label for="sortOrder" class="form-label">정렬순서</label>
                  <input type="number" class="form-control" id="sortOrder" name="sortOrder"
                    value="0" min="0" max="9999" required />
                </div>

                <div class="mb-3">
                  <label for="useYn" class="form-label">사용여부</label>
                  <select class="form-select" id="useYn" name="useYn" data-code-group="USE_YN" required></select>
                </div>

                <div id="formMessage" class="mb-3" role="alert"></div>

                <button type="submit" class="btn btn-primary">생성</button>
                <a href="/admin" class="btn btn-outline-secondary">취소</a>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
    {{> footer version="0.0.1"}}
  </div>

  {{> scripts}}
  <script src="/js/admin/form-util.js"></script>
  <script src="/js/admin/menu/new.js"></script>
</body>
</html>
