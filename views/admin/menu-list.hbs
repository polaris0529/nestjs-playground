<!DOCTYPE html>
<html lang="ko">
{{> head title="메뉴 관리"}}
<body>
  {{> header}}
  {{> sidebar page="admin-menu"}}

  <div class="app-main">
    <div class="app-content">
      <div class="page-header">
        <div>
          <h1>메뉴 관리</h1>
          <p>메뉴 목록 조회 · 수정 · 삭제</p>
        </div>
        <a href="/admin/menu/new" class="btn btn-primary">신규 메뉴</a>
      </div>

      <div id="formMessage" role="alert"></div>

      <div class="card shadow-md rounded-lg">
        <div class="card-body">
          <table id="menuTable" class="admin-table"></table>
        </div>
      </div>
    </div>
    {{> footer version="0.0.1"}}
  </div>

  <!-- 수정 모달 -->
  <div id="menuEditModal" class="modal-overlay d-none">
    <div class="modal-box">
      <div class="modal-head">
        <h2 class="modal-title">메뉴 수정</h2>
        <button type="button" class="modal-close" data-modal-close>&times;</button>
      </div>
      <div class="modal-body">
        <form id="menuEditForm" novalidate>
          <input type="hidden" id="editId" />
          <div class="mb-3">
            <label class="form-label">메뉴코드</label>
            <input type="text" class="form-control" id="editMenuCode" disabled />
          </div>
          <div class="mb-3">
            <label for="editParentMenuId" class="form-label">상위 메뉴</label>
            <select class="form-select" id="editParentMenuId"></select>
          </div>
          <div class="mb-3">
            <label for="editMenuName" class="form-label">메뉴명</label>
            <input type="text" class="form-control" id="editMenuName" required />
          </div>
          <div class="mb-3">
            <label for="editMenuUrl" class="form-label">메뉴 URL</label>
            <input type="text" class="form-control" id="editMenuUrl" />
          </div>
          <div class="mb-3">
            <label for="editMenuType" class="form-label">메뉴유형</label>
            <select class="form-select" id="editMenuType" data-code-group="MENU_TYPE" required></select>
          </div>
          <div class="mb-3">
            <label for="editOpenType" class="form-label">열기방식</label>
            <select class="form-select" id="editOpenType" data-code-group="OPEN_TYPE"></select>
          </div>
          <div class="mb-3">
            <label for="editSortOrder" class="form-label">정렬순서</label>
            <input type="number" class="form-control" id="editSortOrder" min="0" max="9999" required />
          </div>
          <div class="mb-3">
            <label for="editUseYn" class="form-label">사용여부</label>
            <select class="form-select" id="editUseYn" data-code-group="USE_YN" required></select>
          </div>
          <div id="modalMessage" role="alert"></div>
          <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary" data-modal-close>취소</button>
            <button type="submit" class="btn btn-primary">저장</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  {{> scripts}}
  <script src="/js/admin/form-util.js"></script>
  <script src="/js/admin/crud-util.js"></script>
  <script src="/js/admin/menu/list.js"></script>
</body>
</html>
