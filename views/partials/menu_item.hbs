{{#if menuUrl}}
  <a href="{{menuUrl}}" class="nav-link"{{#if (eq openType "BLANK")}} target="_blank" rel="noopener"{{/if}}>
    <span class="nav-text">{{menuName}}</span>
  </a>
{{else}}
  <div class="nav-link nav-folder" data-menu-toggle>
    <span class="nav-caret">&#9656;</span>
    <span class="nav-text">{{menuName}}</span>
  </div>
{{/if}}
{{#if children.length}}
  <div class="nav-subgroup">
    {{#each children}}
      {{> menu_item}}
    {{/each}}
  </div>
{{/if}}
