<header class="app-header">
  <button id="sidebar-toggle" class="sidebar-toggle-btn" aria-label="사이드바 토글">&#9776;</button>
  <a href="/" class="brand">WorkFlow</a>
  <div class="header-right">
    {{#if user}}
      <span class="header-item">{{user.loginId}}</span>
      <form action="/auth/logout" method="post" class="header-logout-form">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <button type="submit" class="btn btn-sm btn-outline-light">로그아웃</button>
      </form>
    {{else}}
      <a href="/login" class="header-item">로그인</a>
    {{/if}}
  </div>
</header>
